{
  "version": 2,
  "public": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "methods": ["OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "https://verveutils.web.app",
        "Access-Control-Allow-Methods": "GET, POST, PATCH, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "continue": false,
      "status": 204
    },
    {
      "src": "/api/tickets/([^/]+)",
      "dest": "/api/tickets/[id].js"
    },
    {
      "src": "/api/tickets",
      "dest": "/api/tickets/index.js"
    }
  ]
}