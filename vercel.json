{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "api/**",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/tickets/:id",
      "dest": "/api/tickets/[id].js",
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "src": "/api/tickets",
      "dest": "/api/tickets/index.js",
      "headers": { "Cache-Control": "no-store" }
    }
  ]
}